<?xml version="1.0" encoding="utf-8"?>
<!-- The 4×4 widget. Drawn in the app's Style and accent colour; see MediaWidget. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_large_description"
    android:initialLayout="@layout/widget_styled_large"
    android:minHeight="250dp"
    android:minWidth="250dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="250dp"
    android:previewLayout="@layout/widget_styled_large"
    android:resizeMode="horizontal|vertical"
    android:targetCellHeight="4"
    android:targetCellWidth="4"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen|keyguard" />
