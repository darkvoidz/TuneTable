<!--
  Status-bar / notification variant of Aural's mark.

  Notification small icons are drawn as a silhouette: the system throws away
  every colour and keeps only the alpha channel, so the stroke is opaque white.
  The wave's bounds (58x38 around x 25, y 31) are scaled into the 22dp content
  box Android expects inside a 24x24 canvas, and centred.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <group
        android:scaleX="0.3793"
        android:scaleY="0.3793"
        android:translateX="-8.483"
        android:translateY="-6.966">
        <path
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="6.5"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M28,60h6l4,-6l5,12l11,-32l11,32l5,-12l4,6h6" />
    </group>
</vector>
